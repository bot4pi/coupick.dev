# spotify app from developer.spotify.com (the same one spotify-telegram-sync uses works fine).
# the refresh token needs the `user-read-currently-playing` scope;
# add `user-read-recently-played` to also show recent tracks when nothing is playing.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# optional. without a key the card shows the public all-time stats of WAKATIME_USERNAME;
# with one (wakatime.com/settings/api-key) it shows the last 7 days day by day.
WAKATIME_API_KEY=
WAKATIME_USERNAME=coup

# visitor counter: added automatically when an upstash for redis store is connected on vercel (storage tab).
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=
